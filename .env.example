# API ------------------------------------------------------------------------
# Enables GRI reasoning in the classifier. Without it the classifier still runs
# on CBP ruling precedent alone, at lower accuracy.
ANTHROPIC_API_KEY=

# Model used for classification reasoning.
TARIFFWISE_MODEL=claude-opus-5

# Comma-separated origins allowed to call the API. Empty denies all
# cross-origin requests, which is correct when the web app proxies server-side.
TARIFFWISE_ORIGINS=

# Comma-separated keys that lift anonymous rate limits and raise the audit
# ceiling from 25 to 1000 items. Generate with: openssl rand -hex 32
TARIFFWISE_API_KEYS=

# Wall-clock ceiling for a single catalogue audit, in seconds.
TARIFFWISE_AUDIT_BUDGET=45

# Set to 1 only when running behind a proxy that sets X-Forwarded-For.
# Otherwise the header is forgeable and rate limiting can be evaded.
TARIFFWISE_BEHIND_PROXY=0

# Web ------------------------------------------------------------------------
# Server-side API origin used during rendering.
TARIFFWISE_API=http://127.0.0.1:8099
# Key the web app presents to the engine when proxying audits. Never prefix
# this NEXT_PUBLIC_ — that publishes it to every visitor.
TARIFFWISE_API_KEY=
# Canonical site URL for metadata, sitemaps and robots.
SITE_URL=https://example.com

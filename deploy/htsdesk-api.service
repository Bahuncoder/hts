[Unit]
Description=HTSDesk API
After=network.target

[Service]
Type=simple
User=htsdesk
WorkingDirectory=/opt/htsdesk
Environment=PYTHONUNBUFFERED=1
# Holds ANTHROPIC_API_KEY, HTSDESK_API_KEYS and HTSDESK_ORIGINS.
# Must be root-owned and mode 0600: it contains credentials.
EnvironmentFile=/etc/htsdesk/api.env

# nginx terminates TLS and sets X-Forwarded-For, so the last hop is
# trustworthy. Never set this when the API is directly reachable — the header
# is caller-supplied and rate limiting could be evaded by forging it.
Environment=HTSDESK_BEHIND_PROXY=1

# The in-process rate limiter counts per worker. Two workers double every
# application limit, which is why nginx holds the authoritative one.
# --no-server-header: uvicorn otherwise advertises itself, which narrows an
# attacker's search for a matching advisory and tells a caller nothing useful.
# It cannot be suppressed from application middleware, which runs earlier.
ExecStart=/opt/htsdesk/.venv/bin/uvicorn api.main:app \
    --host 127.0.0.1 --port 8099 --workers 2 --no-server-header

Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
# The reference database is the only path that must stay writable (WAL).
ReadWritePaths=/opt/htsdesk/data

[Install]
WantedBy=multi-user.target

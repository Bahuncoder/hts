[Unit]
Description=HTSDesk change diff (match tariff actions against watched codes)
After=network.target

[Service]
Type=oneshot
User=htsdesk
# Holds HTSDESK_ADMIN_TOKEN and HTSDESK_WEB_URL (the Vercel deployment's
# origin — the web app owns the accounts database and this job runs on the
# API host, not alongside it).
EnvironmentFile=/etc/htsdesk/api.env
ExecStart=/usr/bin/curl --fail --silent --show-error --max-time 120 \
    -X POST "${HTSDESK_WEB_URL}/api/admin/diff" \
    -H "x-admin-token: ${HTSDESK_ADMIN_TOKEN}"

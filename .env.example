# API ------------------------------------------------------------------------
# Enables GRI reasoning in the classifier. Without it the classifier still runs
# on CBP ruling precedent alone, at lower accuracy.
ANTHROPIC_API_KEY=

# Model used for classification reasoning.
HTSDESK_MODEL=claude-opus-5

# Comma-separated origins allowed to call the API. Empty denies all
# cross-origin requests, which is correct when the web app proxies server-side.
HTSDESK_ORIGINS=

# Comma-separated keys that lift anonymous rate limits and raise the audit
# ceiling from 25 to 1000 items. Generate with: openssl rand -hex 32
HTSDESK_API_KEYS=

# Wall-clock ceiling for a single catalogue audit, in seconds.
HTSDESK_AUDIT_BUDGET=45

# Set to 1 only when running behind a proxy that sets X-Forwarded-For.
# Otherwise the header is forgeable and rate limiting can be evaded. Applies to
# both the duty engine and the web app's sign-in throttle.
HTSDESK_BEHIND_PROXY=0

# Web ------------------------------------------------------------------------
# Server-side API origin used during rendering.
HTSDESK_API=http://127.0.0.1:8099
# Key the web app presents to the engine when proxying audits. Never prefix
# this NEXT_PUBLIC_ — that publishes it to every visitor.
HTSDESK_API_KEY=
# Canonical site URL for metadata, sitemaps and robots.
SITE_URL=https://example.com

# Billing (Stripe) --------------------------------------------------------------
# Create the two recurring prices in Stripe, then paste their price ids here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=

# Email ------------------------------------------------------------------------
# Set exactly one provider key. With neither, alert digests are generated and
# recorded as "skipped" rather than sent, so the path is exercised before a key
# exists. Resend takes precedence if both are set.
RESEND_API_KEY=
POSTMARK_API_KEY=

HTSDESK_EMAIL_FROM=HTSDesk <alerts@htsdesk.com>
HTSDESK_EMAIL_REPLY_TO=hello@htsdesk.com

# Signs unsubscribe links so they work without a session and cannot be guessed
# for someone else's account. Falls back to HTSDESK_ADMIN_TOKEN if unset.
# Generate with: openssl rand -hex 32
HTSDESK_EMAIL_SECRET=

# Scheduled jobs ---------------------------------------------------------------
# Shared token for the change-diff runner. Without it /api/admin/diff refuses
# every call, so a deployment that forgets it is closed rather than open.
# Generate with: openssl rand -hex 32
HTSDESK_ADMIN_TOKEN=

# Accounts ---------------------------------------------------------------------
# The one database that cannot be regenerated from public sources. Back this up.
HTSDESK_ACCOUNTS_DB=./data/accounts.db
# Read-only reference database, used by the diff to read tariff actions.
HTSDESK_REFERENCE_DB=./data/htsdesk.db

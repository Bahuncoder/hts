[Unit]
Description=HTSDesk accounts backup
After=network.target

[Service]
Type=oneshot
User=htsdesk
Environment=HTSDESK_ACCOUNTS_DB=/opt/htsdesk/data/accounts.db
Environment=HTSDESK_BACKUP_DIR=/var/backups/htsdesk
Environment=HTSDESK_BACKUP_KEEP=30
ExecStart=/usr/bin/python3 /opt/htsdesk/ops/backup-accounts.py
ReadWritePaths=/var/backups/htsdesk
